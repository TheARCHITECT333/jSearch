# The backend has NO LLM defaults: provider, base URL, model and API key
# are configured in the web UI and sent per request. Nothing needed here.
#
# Every value below is optional - the defaults in code are the ones used by
# docker-compose.yml.

# --- Logging ---------------------------------------------------------------
# Verbosity (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO
# `text` is human-readable; `json` emits one JSON object per line for
# grepping or shipping to a log collector.
LOG_FORMAT=text

# --- Persistence -----------------------------------------------------------
# SQLite file for job/search/profile history. In Docker this is
# sqlite:////data/jobhunter.db, backed by the `jobhunter-data` volume.
# Schema changes are applied by Alembic on startup.
DATABASE_URL=sqlite:///./jobhunter.db

# Jobs matched within this many days are reused instead of re-matched.
SEEN_JOB_TTL_DAYS=7

# --- Search execution ------------------------------------------------------
# Searches running at once, and how many may sit in the queue behind them.
SEARCH_WORKERS=2
SEARCH_QUEUE_MAX=50

# --- Reliability -----------------------------------------------------------
# Companies browsing simultaneously within one search.
COMPANY_CONCURRENCY=4
# Hard process-wide cap on live Chromium contexts (the RAM guard).
MAX_BROWSER_CONTEXTS=8
# FLOOR for a whole search's time budget, in seconds. The effective budget
# scales with the company count, so this does not need raising when the
# company list grows - see search_budget_seconds() in services/search.py.
SEARCH_TIMEOUT_S=1800
# Discovery tries per company (1 attempt + 1 retry). Only transient failures
# are retried - a timeout or an unresponsive model is not, because a second
# attempt costs another full budget and asks the same server the same things.
DISCOVERY_ATTEMPTS=2

# --- LLM throughput --------------------------------------------------------
# How many LLM requests may be in flight at once, process-wide.
#
# Keep this at 1 for a stock Ollama: it serves one request per model, so
# several company agents firing at once just queue inside the server - and
# the loser can wait past its HTTP timeout and come back with nothing.
# Raise it only if the server really is parallel (Ollama's
# OLLAMA_NUM_PARALLEL, or a hosted API).
LLM_CONCURRENCY=1

# --- Career agent ----------------------------------------------------------
# Every agent step costs one LLM round trip, so the right values depend
# entirely on how fast your model answers. Watch the `llm call:` log lines:
# `gen=` is the model's own speed, `wait=` is time spent queued.
# Wall-clock cap for one company, in seconds. Time spent queued behind
# another agent's LLM call does NOT count against it.
AGENT_TIMEOUT_S=420
# Total actions the agent may take on one site.
AGENT_MAX_STEPS=30
# Job detail pages it may open on one site.
AGENT_MAX_JOB_VISITS=12

# How often the SSE stream re-checks a search for changes, in seconds.
SSE_TICK_SECONDS=1.0
